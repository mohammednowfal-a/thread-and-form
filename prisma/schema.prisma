generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  OWNER
  ADMIN
  OPS_MANAGER
  FULFILLMENT
  SUPPORT
  ANALYST
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  FAILED_DELIVERY
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  COLLECTED
  VOID
}

// Customer-side confirmation state. Separate from message delivery state (WhatsAppMessage.status)
enum ConfirmationStatus {
  NOT_REQUIRED
  AWAITING
  CONFIRMED
  CANCEL_REQUESTED
  CANCELLED
  MANUAL_REVIEW
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  DEAD
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
}

enum IntegrationStatus {
  NOT_CONNECTED
  DEMO
  CONNECTED
  ERROR
}

model Tenant {
  id                          String   @id @default(cuid())
  slug                        String   @unique
  name                        String
  currency                    String   @default("INR")
  shippingFeePaise            Int      @default(9900)
  freeShippingThresholdPaise  Int      @default(199900)
  codMaxTotalPaise            Int      @default(1500000)
  codFeePaise                 Int      @default(0)
  supportEmail                String?
  supportPhone                String?
  whatsappConfirmEnabled      Boolean  @default(true)
  confirmationExpiryHours     Int      @default(48)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  memberships   Membership[]
  customers     Customer[]
  categories    Category[]
  products      Product[]
  variants      ProductVariant[]
  inventory     InventoryRecord[]
  orders        Order[]
  conversations WhatsAppConversation[]
  messages      WhatsAppMessage[]
  integrations  IntegrationAccount[]
  shipments     Shipment[]
  returns       ReturnRequest[]
  auditLogs     AuditLog[]
  jobs          Job[]
  carts         Cart[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())

  memberships Membership[]
  sessions    StaffSession[]
  resets      PasswordReset[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      RoleKey
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model StaffSession {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  activeTenantId String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id                String    @id @default(cuid())
  tenantId          String
  email             String?
  name              String
  phone             String?
  passwordHash      String?
  emailVerifiedAt   DateTime?
  whatsappOptInAt   DateTime?
  whatsappOptOutAt  DateTime?
  createdAt         DateTime  @default(now())

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]
  sessions  CustomerSession[]
  resets    PasswordReset[]
  carts     Cart[]

  @@unique([tenantId, email])
  @@index([tenantId, phone])
}

model CustomerSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  customerId String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model PasswordReset {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String?
  customerId String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerAddress {
  id         String  @id @default(cuid())
  customerId String
  label      String  @default("Home")
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Category {
  id       String @id @default(cuid())
  tenantId String
  slug     String
  name     String
  blurb    String @default("")
  position Int    @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
}

model Product {
  id               String        @id @default(cuid())
  tenantId         String
  categoryId       String
  slug             String
  name             String
  description      String
  material         String        @default("")
  fit              String        @default("")
  pricePaise       Int
  comparePricePaise Int?
  sku              String
  status           ProductStatus @default(DRAFT)
  isNew            Boolean       @default(false)
  isFeatured       Boolean       @default(false)
  searchText       String        @default("")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category         @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]

  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, categoryId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String @default("")
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id                String  @id @default(cuid())
  tenantId          String
  productId         String
  size              String
  color             String
  colorHex          String  @default("#cccccc")
  sku               String
  priceOverridePaise Int?
  active            Boolean @default(true)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory InventoryRecord?
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@unique([productId, size, color])
  @@index([productId])
}

// Inventory policy: stock is RESERVED when a COD order is placed (reserved += qty, only if onHand - reserved >= qty).
// Cancel / expiry releases the reservation. Shipping consumes it (onHand -= qty, reserved -= qty).
model InventoryRecord {
  id                String @id @default(cuid())
  tenantId          String
  variantId         String @unique
  onHand            Int    @default(0)
  reserved          Int    @default(0)
  lowStockThreshold Int    @default(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Cart {
  id         String   @id @default(cuid())
  tenantId   String
  tokenHash  String   @unique
  customerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([customerId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Order {
  id                 String             @id @default(cuid())
  tenantId           String
  publicRef          String
  customerId         String?
  contactName        String
  contactPhone       String
  contactEmail       String?
  shippingAddress    Json
  currency           String             @default("INR")
  subtotalPaise      Int
  discountPaise      Int                @default(0)
  shippingPaise      Int                @default(0)
  taxPaise           Int                @default(0)
  codFeePaise        Int                @default(0)
  totalPaise         Int
  paymentMethod      PaymentMethod      @default(COD)
  paymentStatus      PaymentStatus      @default(PENDING)
  status             OrderStatus        @default(PENDING_CONFIRMATION)
  confirmationStatus ConfirmationStatus @default(AWAITING)
  confirmedAt        DateTime?
  confirmationSource String?
  cancelledAt        DateTime?
  cancelSource       String?
  cancelReason       String?
  stockHeld          Boolean            @default(true)
  whatsappConsent    Boolean            @default(false)
  idempotencyKey     String
  expiresAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  history      OrderStatusHistory[]
  cod          CodConfirmation?
  messages     WhatsAppMessage[]
  shipments    Shipment[]
  returns      ReturnRequest[]

  @@unique([tenantId, publicRef])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, contactPhone])
  @@index([customerId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  variantId      String?
  productId      String?
  nameSnapshot   String
  sizeSnapshot   String
  colorSnapshot  String
  skuSnapshot    String
  unitPricePaise Int
  quantity       Int
  lineTotalPaise Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  source      String
  actorUserId String?
  note        String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model CodConfirmation {
  id                String    @id @default(cuid())
  orderId           String    @unique
  tenantId          String
  status            String    @default("PENDING") // PENDING | CONFIRMED | CANCELLED | EXPIRED
  requestMessageId  String?
  resolvedMessageId String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WhatsAppConversation {
  id            String    @id @default(cuid())
  tenantId      String
  waId          String
  profileName   String?
  lastInboundAt DateTime?
  optedOutAt    DateTime?
  pendingAction Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]

  @@unique([tenantId, waId])
}

model WhatsAppMessage {
  id                String           @id @default(cuid())
  tenantId          String
  conversationId    String
  direction         MessageDirection
  providerMessageId String?
  kind              String           @default("text") // text | template | interactive | button_reply
  body              String           @default("")
  templateName      String?
  orderId           String?
  status            MessageStatus
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime         @default(now())

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([tenantId, providerMessageId])
  @@index([conversationId, createdAt])
  @@index([orderId])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String
  externalId  String
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  error       String?
  receivedAt  DateTime      @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
  @@index([status, receivedAt])
}

model Job {
  id          String    @id @default(cuid())
  tenantId    String?
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(6)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
}

model IntegrationAccount {
  id            String            @id @default(cuid())
  tenantId      String
  provider      String // whatsapp | email | shiprocket | delhivery | shopify
  status        IntegrationStatus @default(NOT_CONNECTED)
  config        Json              @default("{}")
  lastCheckedAt DateTime?
  lastError     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

model Shipment {
  id             String   @id @default(cuid())
  tenantId       String
  orderId        String
  provider       String
  trackingNumber String?
  labelUrl       String?
  status         String   @default("CREATED")
  lastEvent      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, trackingNumber])
  @@index([orderId])
}

model ReturnRequest {
  id         String       @id @default(cuid())
  tenantId   String
  orderId    String
  reason     String
  status     ReturnStatus @default(REQUESTED)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  actorUserId String?
  actorLabel  String
  action      String
  entityType  String
  entityId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime
}
