# --- Core ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/threadform?schema=public"
APP_URL="http://localhost:3000"
# 32+ random chars. Generate: openssl rand -hex 32
SESSION_SECRET=""
# Slug of the tenant served by the public storefront
STOREFRONT_TENANT_SLUG="thread-and-form"
# Secret that protects POST /api/jobs/run (used by cron/worker). openssl rand -hex 24
JOBS_SECRET=""
ALLOW_GUEST_CHECKOUT="true"

# --- WhatsApp Cloud API (Meta). Leave blank = integration reports "Not connected" ---
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"
# Names of templates approved in Meta Business Manager
WHATSAPP_TEMPLATE_COD_CONFIRM="cod_order_confirmation"
WHATSAPP_TEMPLATE_ORDER_STATUS="order_status_update"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# --- Optional AI provider (intent assist only; business rules stay deterministic) ---
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL=""

# --- Email (Resend-compatible HTTP API). Blank = emails are stored but not sent ---
EMAIL_API_KEY=""
EMAIL_FROM="THREAD & FORM <orders@example.com>"

# --- Shipping (blank = Not connected) ---
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_WEBHOOK_TOKEN=""
DELHIVERY_API_TOKEN=""
DELHIVERY_WEBHOOK_TOKEN=""

# --- Shopify (blank = Not connected) ---
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_ADMIN_TOKEN=""
